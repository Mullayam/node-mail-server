# Copy to relay/.env (gitignored). Accounts, their domains and webhooks live in policy/users.lua.

# Public hostname for the SMTP banner and EHLO. Must match the sending IP's PTR record.
KUMOMTA_HOSTNAME=relay.example.com

# Comma-separated outbound IPs (IPv4 and/or IPv6). Leave unset to send from the default route.
# KUMOMTA_SOURCE_IPS=203.0.113.20

# RELAY_LISTEN=0.0.0.0:2587

# STARTTLS certificate (container paths; uncomment the tls mount in compose). Unset = self-signed.
# RELAY_TLS_CERT=/opt/kumomta/etc/tls/fullchain.pem
# RELAY_TLS_KEY=/opt/kumomta/etc/tls/privkey.pem

# Unset = deliver to each recipient's MX. Set = hand every message to this host.
# RELAY_SMARTHOST=smtp.example.net
# RELAY_SMARTHOST_PORT=587
# RELAY_SMARTHOST_USER=
# RELAY_SMARTHOST_PASS=
# RELAY_SMARTHOST_CONNECTIONS=10
# Required | RequiredInsecure | Opportunistic | OpportunisticInsecure | Disabled
# RELAY_SMARTHOST_TLS=Required

RELAY_RETRY_INTERVAL=1m
RELAY_MAX_RETRY_INTERVAL=4h
RELAY_MAX_AGE=24h

# DKIM keys: file | http | redis | none
#   file  -> /opt/kumomta/etc/dkim/<domain>/<selector>.key (uncomment the dkim mount in compose)
#   http  -> GET $DKIM_HTTP_URL?domain=<d>&selector=<s> with header X-API-Key: $DKIM_API_KEY
#   redis -> GET "<domain>::pvt::key" from $REDIS_HOST:$REDIS_PORT
DKIM_BACKEND=http
DKIM_SELECTOR=default
DKIM_HTTP_URL=https://api.example.com/dkim
DKIM_API_KEY=change-me

REDIS_HOST=redis
REDIS_PORT=6379

# How long an account's webhook keeps being retried before an event is dropped, and per-request timeout.
# WEBHOOK_MAX_AGE=3d
# WEBHOOK_TIMEOUT=10s

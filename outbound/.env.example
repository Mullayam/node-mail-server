# Copy to outbound/.env (gitignored). deploy/docker-compose.yml passes it to KumoMTA.

# Public hostname for the SMTP banner and EHLO. Must match the server's PTR record.
KUMOMTA_HOSTNAME=mail.example.com

# Comma-separated outbound IPs (IPv4 and/or IPv6), one egress source each.
# Leave unset to send from the default route.
# KUMOMTA_SOURCE_IPS=203.0.113.10,203.0.113.11

# true  = also check the sender domain against policy/domains.lua and DKIM-sign.
# false = skip both. SMTP AUTH is required either way.
USE_RELAY=false

# Where DKIM private keys come from: file | http | redis
#   file  -> /opt/kumomta/etc/dkim/<domain>/<selector>.key (uncomment the dkim mount in compose)
#   http  -> GET $DKIM_HTTP_URL?domain=<d>&selector=<s> with header X-API-Key: $DKIM_API_KEY
#   redis -> GET "<domain>::pvt::key" from $REDIS_HOST:$REDIS_PORT
DKIM_BACKEND=http
DKIM_SELECTOR=default
DKIM_HTTP_URL=https://api.example.com/dkim
DKIM_API_KEY=change-me

# "redis" is the service name in deploy/docker-compose.yml.
REDIS_HOST=redis
REDIS_PORT=6379

# Delivery, bounce and deferral events are POSTed here as JSON. Leave unset to disable.
WEBHOOK_URL=https://api.example.com/webhooks/kumomta
WEBHOOK_SECRET=change-me

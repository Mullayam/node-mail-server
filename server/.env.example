# Copy to server/.env (gitignored), or run ./scripts/run.sh to generate it.

# Server
INCOMING_MAIL_HOST=mx.example.com
OUTGOING_MAIL_HOST=smtp.example.com
MAIL_SERVER_IP=203.0.113.10
MAX_EMAILS_PER_MINUTE=5

# TLS (Let's Encrypt paths for OUTGOING_MAIL_HOST)
TLS_PRIVATE_KEY_PATH=/etc/letsencrypt/live/smtp.example.com/privkey.pem
TLS_CERTFICATE_PATH=/etc/letsencrypt/live/smtp.example.com/fullchain.pem

# DKIM (signing in the Node outgoing path)
DKIM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
DKIM_SELECTOR=default

# PGP (at-rest encryption for incoming mail)
PGP_PRIVATE_KEY="-----BEGIN PGP PRIVATE KEY BLOCK-----\n..."
PGP_PUBLIC_KEY="-----BEGIN PGP PUBLIC KEY BLOCK-----\n..."
PGP_REVOCATION_CERTIFICATE="-----BEGIN PGP PUBLIC KEY BLOCK-----\n..."
PGP_PASSPHRASE=change-me

# Files. Behaviour (checks, limits, queue, bounces) lives in config/mail.config.json,
# SMTP reply texts in config/smtp-messages.json. Both reload while the server runs.
MAIL_SPOOL_DIR=./spool
# SQLite files the server keeps, such as data/ip-blocks.db (blocked IPs).
MAIL_DATA_DIR=./data
MAIL_CONFIG_PATH=./config/mail.config.json
SMTP_MESSAGES_PATH=./config/smtp-messages.json

# Outbound driver: direct | go | relay | kumo-http
OUTBOUND_DRIVER=direct

# relay driver (SMTP submission, e.g. KumoMTA on the private network)
OUTBOUND_RELAY_HOST=
OUTBOUND_RELAY_PORT=587
OUTBOUND_RELAY_USER=
OUTBOUND_RELAY_PASS=
OUTBOUND_RELAY_CA_PATH=
OUTBOUND_RELAY_TLS=verify
OUTBOUND_RELAY_MAX_CONNECTIONS=5

# kumo-http driver
KUMO_HTTP_URL=http://kumomta:8000
KUMO_HTTP_USER=
KUMO_HTTP_PASS=
KUMO_HTTP_TIMEOUT_MS=30000
# Sends template_dialect "Static" so KumoMTA never templates the raw message (needs KumoMTA 2025.12.02+)
KUMO_HTTP_STATIC_CONTENT=true

# go driver
GO_MTA_URL=http://go-mta:2580
GO_MTA_TOKEN=
GO_MTA_TIMEOUT_MS=300000

# Bounces
BOUNCE_DOMAIN=
BOUNCE_SMTP_HOST=0.0.0.0
BOUNCE_SMTP_PORT=2525
BOUNCE_HTTP_HOST=0.0.0.0
BOUNCE_HTTP_PORT=8025
BOUNCE_WEBHOOK_TOKEN=
BOUNCE_EVENTS_WEBHOOK_URL=
BOUNCE_EVENTS_WEBHOOK_TOKEN=

# JSON send API (off until a token is set)
MAIL_API_HOST=0.0.0.0
MAIL_API_PORT=8080
MAIL_API_TOKEN=

# Worker threads (empty = CPU cores - 1, max 4; 0 = main thread)
MAIL_WORKERS=
MAIL_WORKER_CONCURRENCY=4
MAIL_WORKER_MAX_QUEUE=1000
MAIL_WORKER_TIMEOUT_MS=120000

# Optional: ARC sealing of incoming mail
ARC_PRIVATE_KEY_PATH=
ARC_SIGNING_DOMAIN=
ARC_SELECTOR=default

# IMAP: store incoming mail in the IMAP server over LMTP, so it shows up in mail
# clients at once. Set IMAP_LMTP_HOST=imap when the imap service runs
# (docker compose --profile imap). Unset: incoming mail is checked but not stored.
IMAP_LMTP_HOST=
IMAP_LMTP_PORT=24
IMAP_LMTP_TIMEOUT_MS=60000
